<!-- 实名认证页 — 墨绿体系; 未绑定: 表单可编辑; 已绑定: 脱敏回显 + 重新绑定 -->
<view class="page">
  <view class="head">
    <view class="head-card">
      <view class="head-title">实名信息</view>
      <view class="head-sub">实名信息仅用于入馆核验与防刷, 加密存储、脱敏展示</view>
    </view>
  </view>

  <view class="container">
    <view class="state-tag {{verified ? 'state-ok' : 'state-todo'}}">
      {{verified ? '✓ 已实名' : '未实名, 完成后可预约'}}
    </view>

    <view class="form-card">
      <view class="form-item {{errors.name ? 'item-err' : ''}}">
        <text class="form-label">姓名</text>
        <input wx:if="{{!verified}}" class="form-input" value="{{real_name}}" bindinput="onName"
               placeholder="与身份证一致" placeholder-class="ph" disabled="{{submitting}}" />
        <view wx:else class="form-plain">{{real_name_masked}}</view>
      </view>
      <view class="form-err" wx:if="{{errors.name}}">{{errors.name}}</view>

      <view class="form-item">
        <text class="form-label">身份证号</text>
        <input wx:if="{{!verified}}" class="form-input" value="{{id_card_no}}" bindinput="onCard"
               placeholder="18 位身份证号" maxlength="18" placeholder-class="ph" disabled="{{submitting}}" />
        <view wx:else class="form-plain">{{id_card_masked}}</view>
      </view>
      <view class="form-err" wx:if="{{errors.card}}">{{errors.card}}</view>

      <view class="form-item">
        <text class="form-label">手机号</text>
        <input wx:if="{{!verified}}" class="form-input" value="{{phone}}" bindinput="onPhone" type="number"
               placeholder="11 位手机号" maxlength="11" placeholder-class="ph" disabled="{{submitting}}" />
        <view wx:else class="form-plain">{{phone_masked}}</view>
      </view>
      <view class="form-err" wx:if="{{errors.phone}}">{{errors.phone}}</view>
    </view>

    <view class="tip">
      <text>🔒</text>
      <text>实名信息 AES 加密存储, 仅用于预约核验; 同证件同日限约 3 次, 请勿转借他人。</text>
    </view>

    <button wx:if="{{!verified}}" class="submit-btn" loading="{{submitting}}"
            disabled="{{submitting}}" bindtap="submit">提交实名</button>
    <button wx:else class="rebind-btn" bindtap="onRebind">重新绑定</button>
  </view>
</view>