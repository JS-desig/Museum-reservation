/* 展项列表页 — 墨绿体系 #386B56 / 背景 #F6F8F7 */

page {
  background: #f6f8f7;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.font-trad {
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif CN', 'SimSun', serif;
}

.page { min-height: 100vh; padding-bottom: 60rpx; }

/* ---------- 头部 (与 booking 页同款渐变) ---------- */
.head {
  background: linear-gradient(135deg, #2a5241 0%, #386b56 55%, #4d7e68 100%);
  padding: 36rpx 32rpx 60rpx;
  border-radius: 0 0 32rpx 32rpx;
}
.head-card {
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 20rpx;
  padding: 30rpx 32rpx;
  color: #fff;
}
.head-title { font-size: 38rpx; font-weight: 700; letter-spacing: 2rpx; }
.head-sub { font-size: 23rpx; opacity: 0.82; margin-top: 10rpx; letter-spacing: 1rpx; }

/* ---------- 展厅筛选 (横向滚动) ---------- */
.hall-tabs { position: sticky; top: 0; z-index: 10; margin-top: -28rpx; padding: 0 24rpx; }
.hall-scroll { width: 100%; white-space: nowrap; }
.hall-inner { display: inline-flex; gap: 15rpx; padding: 6rpx 2rpx; }
.hall-tab {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece6;
  font-size: 24rpx;
  color: #4b5563;
  box-shadow: 0 2rpx 8rpx rgba(40, 74, 58, 0.06);
}
.hall-tab.on { background: #386b56; border-color: #386b56; color: #ffffff; font-weight: 600; }
.hall-count { font-size: 20rpx; opacity: 0.75; margin-left: 6rpx; }

/* ---------- 分组 ---------- */
.container { padding: 24rpx 30rpx 0; }
.hall-group { margin-bottom: 36rpx; }
.group-title { display: flex; align-items: center; margin-bottom: 20rpx; }
.group-bar {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #386b56;
  margin-right: 15rpx;
}
.group-title text { font-size: 30rpx; font-weight: 700; color: #111827; letter-spacing: 1rpx; }
.group-count { margin-left: 14rpx; font-size: 21rpx; color: #9ca3af; font-weight: 400 !important; }

/* ---------- 展项卡片 (复用首页 m- 体系) ---------- */
.m-card {
  display: flex;
  padding: 23rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece6;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(40, 74, 58, 0.08), 0 2rpx 6rpx -1rpx rgba(0, 0, 0, 0.04);
}
.m-card + .m-card { margin-top: 23rpx; }
.m-poster {
  position: relative;
  width: 184rpx; height: 246rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #eef2f0;
  margin-right: 27rpx;
}
.m-poster-img { width: 100%; height: 100%; }
.m-poster-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  color: #b6cbc0;
}
.m-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.m-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.45;
  letter-spacing: 0.5rpx;
}
.m-type {
  display: inline-block;
  margin-top: 10rpx;
  align-self: flex-start;
  padding: 3rpx 14rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  color: #417558;
  background: #e8f2ec;
}
.m-desc {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: #9ca3af;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.m-actions { display: flex; justify-content: flex-end; align-items: center; gap: 18rpx; padding-top: 16rpx; margin-top: auto; }
.m-btn {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #386b56;
  background: #ebf3ed;
  border: 1rpx solid #d0e2d6;
}
.m-btn:active { transform: scale(0.95); }
/* 特殊展项: 付费主题按钮 */
.m-btn-special {
  color: #ffffff;
  background: #386b56;
  border-color: #386b56;
}
/* 卡片右上角付费体验角标 */
.special-badge {
  position: absolute;
  top: 0; right: 0;
  padding: 6rpx 16rpx;
  border-radius: 0 24rpx 0 24rpx;
  background: rgba(214, 158, 46, 0.92);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.m-price {
  color: #b26a00;
  font-size: 30rpx;
  font-weight: 700;
}
.m-price-unit { font-size: 19rpx; font-weight: 400; opacity: 0.75; }

/* ---------- 空态/加载 ---------- */
.empty { padding: 120rpx 0; text-align: center; font-size: 26rpx; color: #9ca3af; }
.empty-ico { font-size: 72rpx; margin-bottom: 20rpx; }
.empty-sub { margin-top: 10rpx; font-size: 23rpx; color: #c0c6c3; }
.loading { padding: 80rpx 0; text-align: center; font-size: 24rpx; color: #9ca3af; }
