/* ============================================================
   首页 — 科技馆主题首页
   配色: 墨绿 #386B56 / 米白 #F5F8F6 (design.md 蓝色体系不复用于本页)
   注意: 类名统一 m- 前缀, 避免命中 app.wxss 里的蓝色 .card / .section-title
   ============================================================ */

page {
  background: #f5f8f6;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #1f2937;
}

/* 传统衬线(宋体) — 小程序无法加载 Noto Serif SC, 回退系统宋体 */
.font-trad {
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif CN', 'SimSun', serif;
}

.page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  /* 底部让出自定义 tabBar (高 139rpx) */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* 顶部水墨山峦底纹 (base64 SVG, WXML 不支持 <svg>) */
.ink-bg {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 738rpx;
  opacity: 0.4;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
  z-index: 0;
  background-image: url("data:image/svg+xml;base64,");
}

/* ---------- 图标: base64 SVG ---------- */
.ico {
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.ico-search  { width: 32rpx; height: 32rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-calendar{ width: 46rpx; height: 46rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-scan    { width: 46rpx; height: 46rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-ticket  { width: 46rpx; height: 46rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-user    { width: 46rpx; height: 46rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-clock   { width: 24rpx; height: 24rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-pin     { width: 24rpx; height: 24rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-pin-lg  { width: 28rpx; height: 28rpx; background-image: url("data:image/svg+xml;base64,"); }
.ico-chevron { width: 24rpx; height: 24rpx; background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjOUNBM0FGIiBzdHJva2Utd2lkdGg9IjEuOCIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNOSA1bDcgNy03IDciIHN0cm9rZS13aWR0aD0iMiIvPjwvc3ZnPg=="); }

/* ---------- 品牌头部 (自定义导航, 真实胶囊在右上) ---------- */
.topbar { position: relative; z-index: 20; padding: 0 38rpx; }
.brand-row { padding-top: 16rpx; }
.brand-name {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #111827;
  line-height: 1.25;
}
.brand-addr {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  letter-spacing: 1rpx;
}
.brand-addr .ico { margin-right: 6rpx; }

/* ---------- 搜索框 ---------- */
.searchbar {
  position: relative;
  z-index: 20;
  margin: 16rpx 38rpx 0;
  padding: 18rpx 30rpx;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid #d5e5db;
  border-radius: 999rpx;
}
.searchbar .ico { margin-right: 18rpx; }
.search-ph { font-size: 24rpx; color: #9ca3af; letter-spacing: 1rpx; }

/* ---------- 主推展览 Banner ---------- */
.banner {
  position: relative;
  z-index: 10;
  margin: 30rpx 38rpx 0;
  padding: 38rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #2a5241 0%, #3b6b56 50%, #4d7e68 100%);
  box-shadow: 0 8rpx 24rpx rgba(42, 82, 65, 0.28);
}
/* 右侧墨云水印 (原设计为两个重叠圆) */
.banner-wm {
  position: absolute;
  right: 0; top: 0; bottom: 0;
  width: 338rpx;
  opacity: 0.2;
  overflow: hidden;
  pointer-events: none;
}
.banner-wm::before {
  content: '';
  position: absolute;
  right: -40rpx; top: 50%;
  transform: translateY(-50%);
  width: 300rpx; height: 300rpx;
  border-radius: 50%;
  background: #ffffff;
}
.banner-wm::after {
  content: '';
  position: absolute;
  right: 120rpx; top: 16rpx;
  width: 190rpx; height: 190rpx;
  border-radius: 50%;
  background: #ffffff;
}
.banner-main { position: relative; z-index: 10; display: flex; align-items: center; }
.banner-text { flex: 1; min-width: 0; padding-right: 16rpx; }
.banner-title {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #faf9f5;
  line-height: 1.2;
}
.banner-sub {
  font-size: 24rpx;
  font-weight: 300;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}
.banner-date {
  display: inline-block;
  margin-top: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.2);
  font-size: 19rpx;
  color: #e5e7eb;
}
.banner-btn {
  display: inline-block;
  margin-top: 30rpx;
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  background: #faf9f5;
  color: #386b56;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}
.banner-btn:active { transform: scale(0.95); }
/* 展品图: 无图时用半透明底占位, 不出现裂图 */
.banner-thumb {
  position: relative;
  width: 184rpx; height: 215rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.10);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.banner-thumb-img { width: 100%; height: 100%; }

/* ---------- 四宫格快捷入口 ---------- */
.quick {
  position: relative;
  z-index: 10;
  margin: 38rpx 38rpx 0;
  padding: 30rpx;
  display: flex;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1rpx solid #e3ece6;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(40, 74, 58, 0.08), 0 2rpx 6rpx -1rpx rgba(0, 0, 0, 0.04);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick-item:active .quick-ico { transform: scale(0.95); }
.quick-ico {
  width: 92rpx; height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #e8f2ec;
  transition: transform 0.15s;
}
.quick-label {
  margin-top: 16rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #374151;
  letter-spacing: 0.5rpx;
}

/* ---------- 区块标题 ---------- */
.m-section { position: relative; z-index: 10; margin: 46rpx 38rpx 0; }
.m-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 23rpx;
}
.m-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 1rpx;
}
/* 标题左侧墨绿装饰条 */
.m-title::before {
  content: '';
  width: 8rpx; height: 26rpx;
  border-radius: 4rpx;
  background: #386b56;
  margin-right: 15rpx;
}
.m-more {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #9ca3af;
}
.m-more .ico { margin-left: 4rpx; }

/* ---------- 展览卡片 ---------- */
.m-card {
  display: flex;
  padding: 23rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece6;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(40, 74, 58, 0.08), 0 2rpx 6rpx -1rpx rgba(0, 0, 0, 0.04);
}
.m-card + .m-card { margin-top: 23rpx; }
.m-poster {
  position: relative;
  width: 184rpx; height: 246rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #eef2f0;
  margin-right: 27rpx;
}
.m-poster-img { width: 100%; height: 100%; }
/* 无图占位: 淡绿底 + 居中标识, 避免裂图 */
.m-poster-ph {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx;
  color: #b6cbc0;
}
.m-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 4rpx 0;
}
.m-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.45;
  letter-spacing: 0.5rpx;
}
.m-meta {
  display: flex;
  align-items: center;
  margin-top: 11rpx;
  font-size: 21rpx;
  color: #9ca3af;
}
.m-meta .ico { margin-right: 8rpx; }
.m-meta-hall { color: #417558; }
.m-desc {
  margin-top: 8rpx;
  font-size: 21rpx;
  color: #9ca3af;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.m-actions { display: flex; justify-content: flex-end; align-items: center; gap: 18rpx; padding-top: 16rpx; }
.m-btn {
  padding: 12rpx 30rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #386b56;
  background: #ebf3ed;
  border: 1rpx solid #d0e2d6;
}
.m-btn:active { transform: scale(0.95); }
/* 热门(特殊)展项: 付费体验主题 */
.m-btn-special {
  color: #ffffff;
  background: #386b56;
  border-color: #386b56;
}
.special-badge {
  position: absolute;
  top: 0; right: 0;
  padding: 6rpx 16rpx;
  border-radius: 0 24rpx 0 24rpx;
  background: rgba(214, 158, 46, 0.92);
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.m-price {
  color: #b26a00;
  font-size: 30rpx;
  font-weight: 700;
}
.m-price-unit { font-size: 19rpx; font-weight: 400; opacity: 0.75; }

/* ---------- 活动卡片 ---------- */
.m-act {
  display: flex;
  align-items: center;
  padding: 23rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece6;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(40, 74, 58, 0.08), 0 2rpx 6rpx -1rpx rgba(0, 0, 0, 0.04);
}
.m-act + .m-act { margin-top: 23rpx; }
.m-act-thumb {
  position: relative;
  width: 154rpx; height: 154rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  overflow: hidden;
  background: #eef2f0;
  margin-right: 27rpx;
}
.m-act-thumb-img { width: 100%; height: 100%; }
.m-act-body { flex: 1; min-width: 0; }
.m-act-name {
  font-size: 27rpx;
  font-weight: 700;
  color: #1f2937;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.m-act-time { margin-top: 8rpx; font-size: 21rpx; color: #9ca3af; }
.m-tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 19rpx;
  font-weight: 500;
  color: #d48806;
  background: #fff7e8;
  border: 1rpx solid #ffe7ba;
}

/* ---------- 空态 ---------- */
.m-empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  background: #ffffff;
  border-radius: 32rpx;
  border: 1rpx solid #e3ece6;
}

/* ---------- 场馆信息 (参观指南) ---------- */
.venue-info {
  padding: 8rpx 27rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e3ece6;
  box-shadow: 0 4rpx 20rpx -2rpx rgba(40, 74, 58, 0.08), 0 2rpx 6rpx -1rpx rgba(0, 0, 0, 0.04);
}
.vi-row {
  display: flex;
  align-items: flex-start;
  padding: 23rpx 0;
}
.vi-row + .vi-row { border-top: 1rpx solid #eef2f0; }
.vi-row > .ico { margin-right: 18rpx; margin-top: 4rpx; }
.vi-ico {
  flex-shrink: 0;
  width: 26rpx;
  height: 26rpx;
  margin-right: 18rpx;
  margin-top: 4rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.vi-ico.ico-clock {
  background-image: url("data:image/svg+xml;base64,");
}
.vi-ico.ico-notice {
  background-image: url("data:image/svg+xml;base64,");
}
.vi-body { flex: 1; min-width: 0; }
.vi-label { font-size: 24rpx; font-weight: 600; color: #417558; }
.vi-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #6b7280;
  line-height: 1.6;
}

/* ---------- 收尾标语 ---------- */
.slogan {
  position: relative;
  z-index: 0;
  margin: 60rpx 0 30rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.6;
}
.slogan-text {
  font-size: 24rpx;
  color: #527867;
  letter-spacing: 6rpx;
}
.slogan-line {
  width: 60rpx; height: 1rpx;
  background: #aec5b7;
  margin: 0 16rpx;
}
