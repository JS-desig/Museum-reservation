/* 我的 tab (个人中心) — 墨绿渐变头部卡 + 分组菜单 / 背景 #f8faf7 */

page {
  background: #f8faf7;
  color: #222222;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.font-trad {
  font-family: 'Songti SC', 'STSong', 'Noto Serif SC', 'Source Han Serif CN', 'SimSun', serif;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 0 30rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ---------- 黑名单提示条 ---------- */
.black-tip {
  margin-top: 20rpx;
  padding: 22rpx 28rpx;
  border-radius: 20rpx;
  background: #fdeeee;
  border: 1rpx solid rgba(224, 82, 82, 0.25);
}
.black-title { color: #c0392b; font-size: 26rpx; font-weight: 600; }
.black-reason { color: #e05252; font-size: 24rpx; margin-top: 6rpx; }

/* ---------- 用户信息卡 (渐变头, 与首页/展项页同款) ---------- */
.user-card {
  margin-top: 20rpx;
  padding: 36rpx 32rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #2a5241 0%, #386b56 60%, #4d7e68 100%);
  box-shadow: 0 8rpx 24rpx rgba(42, 82, 65, 0.25);
  overflow: hidden;
  position: relative;
}
/* 右上柔光装饰 */
.user-card::after {
  content: '';
  position: absolute;
  right: -70rpx;
  top: -70rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}
.user-row { display: flex; align-items: center; position: relative; z-index: 1; }
.avatar {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18) no-repeat center / 76rpx 76rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  box-sizing: border-box;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0iI2ZmZmZmZiI+PHBhdGggZD0iTTEyIDEyYzIuMjEgMCA0LTEuNzkgNC00cy0xLjc5LTQtNC00LTQgMS43OS00IDQgMS43OSA0IDQgNHptMCAyYy0yLjY3IDAtOCAxLjM0LTggNHYyaDE2di0yYzAtMi42Ni01LjMzLTQtOC00eiIvPjwvc3ZnPg==");
}
.profile-text { flex: 1; min-width: 0; margin-left: 26rpx; }
.nickname-row { display: flex; align-items: center; }
.nickname {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.uid-row { margin-top: 8rpx; }
.uid { font-size: 22rpx; color: rgba(255, 255, 255, 0.65); letter-spacing: 0.5rpx; }

/* 实名状态胶囊 (卡右侧) */
.ver-pill {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}
.ver-pill.ver-ok {
  background: rgba(255, 255, 255, 0.16);
  color: #ffffff;
}
.ver-pill.ver-ok .ver-dot { background: #7fe3b1; }
.ver-pill.ver-todo {
  background: #f4e3c0;
  color: #7a5310;
}
.ver-pill.ver-todo:active { opacity: 0.85; }
.ver-pill.ver-todo .ver-dot { background: #d69e2e; }
.ver-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

/* 未实名引导条 */
.verify-guide {
  margin-top: 26rpx;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 244, 219, 0.95);
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}
.verify-guide text { font-size: 23rpx; color: #7a5310; }
.verify-guide:active { opacity: 0.85; }
.guide-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #b98a2e;
  border-bottom: 3rpx solid #b98a2e;
  transform: rotate(-45deg);
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* ---------- 凭证概览 ---------- */
.stats {
  margin-top: 24rpx;
  padding: 28rpx 24rpx 8rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #eef2ef;
  box-shadow: 0 4rpx 16rpx rgba(40, 74, 58, 0.05);
}
.stats-head { display: flex; align-items: center; padding: 0 8rpx 20rpx; }
.stats-bar {
  width: 8rpx;
  height: 26rpx;
  border-radius: 4rpx;
  background: #386b56;
  margin-right: 14rpx;
}
.stats-title { font-size: 29rpx; font-weight: 700; color: #111827; letter-spacing: 1rpx; }

.stat-row { display: flex; padding-bottom: 24rpx; }
.stat-row-sub { border-top: 1rpx dashed #eef2ef; padding-top: 22rpx; }
.stat-cell { flex: 1; display: flex; flex-direction: column; align-items: center; }
.stat-cell:active { opacity: 0.7; }
.stat-num { font-size: 38rpx; font-weight: 700; color: #386b56; line-height: 1.2; }
/* 展项行: 金色 (付费主题) */
.num-gold { color: #b26a00; }
/* 爽约>0: 红色警示 */
.num-warn { color: #e05252; }
.stat-label { margin-top: 8rpx; font-size: 22rpx; color: #9ca3af; }
.stat-cell-more { justify-content: center; }
.stat-cell-more .row-arrow { margin-top: 8rpx; }

/* ---------- 菜单分组 ---------- */
.menu-group-title {
  margin: 30rpx 12rpx 16rpx;
  font-size: 24rpx;
  color: #9ca3af;
  letter-spacing: 1rpx;
}
.menu {
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #eef2ef;
  box-shadow: 0 4rpx 16rpx rgba(40, 74, 58, 0.05);
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 25rpx 28rpx;
  background: #ffffff;
}
.row + .row { border-top: 1rpx solid #f3f6f4; }
.row:active { background: #f7faf8; }
/* 重置 button 默认外观 (在线客服那一行) */
.row-btn {
  width: 100%;
  border-radius: 0;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 1.5;
  text-align: left;
  color: #222222;
  box-sizing: border-box;
}
.row-btn::after { border: none; }

.row-left { display: flex; align-items: center; }
/* 图标底座: 淡绿圆角块 */
.row-icon-box {
  width: 64rpx;
  height: 64rpx;
  margin-right: 22rpx;
  border-radius: 18rpx;
  background: #edf4f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.row-icon {
  width: 36rpx;
  height: 36rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}
.row-text { font-size: 27rpx; color: #222222; }
/* 右向箭头 (纯 CSS) */
.row-arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #d4d4d4;
  border-bottom: 3rpx solid #d4d4d4;
  transform: rotate(-45deg);
}

/* ---------- 菜单图标 (墨绿描边) ---------- */
.ico-calendar  { background-image: url("data:image/svg+xml;base64,"); }
.ico-clipboard { background-image: url("data:image/svg+xml;base64,"); }
.ico-contacts  { background-image: url("data:image/svg+xml;base64,"); }
.ico-ticket    { background-image: url("data:image/svg+xml;base64,"); }
.ico-notice    { background-image: url("data:image/svg+xml;base64,"); }
.ico-headset   { background-image: url("data:image/svg+xml;base64,"); }
.ico-gear      { background-image: url("data:image/svg+xml;base64,"); }

/* ---------- 版本脚注 ---------- */
.foot {
  margin-top: 40rpx;
  text-align: center;
  font-size: 21rpx;
  color: #b8c4bc;
  letter-spacing: 1rpx;
}
