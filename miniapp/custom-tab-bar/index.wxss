/* 自定义底部菜单 — 1:1 还原设计稿底栏
   白底 / 顶描边 / 极浅上阴影; 选中态墨绿 #386B56, 未选中 #a3a3a3 */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 23rpx 15rpx calc(46rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #f5f5f5;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tabbar-icon {
  width: 42rpx;
  height: 42rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.tabbar-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  line-height: 1;
}
.tabbar-item.off .tabbar-label { color: #a3a3a3; font-weight: 400; }
.tabbar-item.on  .tabbar-label { color: #386b56; font-weight: 500; }

/* ---------- 图标: 每个 tab 两种状态 (base64 SVG) ---------- */
.ico-home-off   { background-image: url("data:image/svg+xml;base64,"); }
.ico-home-on    { background-image: url("data:image/svg+xml;base64,"); }
.ico-ticket-off { background-image: url("data:image/svg+xml;base64,"); }
.ico-ticket-on  { background-image: url("data:image/svg+xml;base64,"); }
.ico-scan-off   { background-image: url("data:image/svg+xml;base64,"); }
.ico-scan-on    { background-image: url("data:image/svg+xml;base64,"); }
.ico-user-off   { background-image: url("data:image/svg+xml;base64,"); }
.ico-user-on    { background-image: url("data:image/svg+xml;base64,"); }
